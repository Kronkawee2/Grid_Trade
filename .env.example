# Shared MySQL server -- the same container mt5-tracker's docker-compose
# runs (quant_mysql on localhost:3308). This project does NOT run its own
# MySQL and does NOT sync any market data; it only reads the raw_* schemas
# that mt5-tracker and Quant_Pair_Trade already populate.
DB_HOST=localhost
DB_PORT=3308
DB_USER=your_db_user
DB_PASSWORD=your_db_password